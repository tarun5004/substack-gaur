NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
ENABLE_SWAGGER=true
TRUST_PROXY=false
MONGO_URI=mongodb://127.0.0.1:27017/sahyogi
JWT_SECRET=replace-with-a-long-shared-secret
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sahyogi <hello@sahyogi.local>"
DEMO_USER_EMAIL=demo.writer@example.com
DEMO_USER_PASSWORD=replace-with-local-demo-password
