{
  "name": "@sahyogi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "node --check src/server.js",
    "start": "node src/server.js",
    "seed:demo": "node src/scripts/seed-demo.js",
    "lint": "eslint .",
    "test": "vitest --watch",
